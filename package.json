{
  "name": "ccgui-plugin-token-meter",
  "version": "0.1.0",
  "private": true,
  "description": "CC GUI 插件：状态栏 token 速度表（tok/s + 缓存命中率），支持全部 11 个引擎",
  "type": "module",
  "packageManager": "pnpm@9.15.0",
  "scripts": {
